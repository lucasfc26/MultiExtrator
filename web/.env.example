# Copie para .env.local. Variáveis VITE_* vão para o bundle — nunca coloque segredos nelas.

# ── Motor de extração (as funções reais deste repositório) ───────────────────
# worker = fala direto com o worker Python (polling, cancelamento, logs).
#          Exige expor a porta 8000 do worker (ver README do web).
# n8n    = usa os webhooks públicos do n8n (chamada síncrona, igual a um cliente da API).
VITE_ENGINE=worker

# Destinos do proxy do Vite (lidos só pelo servidor de desenvolvimento).
WORKER_URL=http://localhost:8000
N8N_URL=http://localhost:5678
# Chave da credencial "MultiExtractor API Key" do n8n. Sem prefixo VITE_:
# o proxy injeta o header e a chave não chega ao navegador.
N8N_API_KEY_HEADER=X-API-Key
N8N_API_KEY=

# ── Plataforma (auth, créditos, pagamentos, API keys, notificações) ──────────
# O backend NestJS ainda não existe. true = dados demonstrativos locais,
# sempre sinalizados na interface. false = chama VITE_API_BASE_URL (contratos provisórios).
VITE_USE_MOCKS=true
VITE_API_BASE_URL=/api/v1
BACKEND_URL=http://localhost:3000
VITE_API_TIMEOUT_MS=30000
