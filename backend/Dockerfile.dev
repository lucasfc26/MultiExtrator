# API Fatturas — imagem de DESENVOLVIMENTO (código montado por volume, hot reload).
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm install -g npm@11 --no-audit --no-fund && npm ci --no-audit --no-fund
COPY prisma ./prisma
RUN npx prisma generate

EXPOSE 3000
# migrate deploy aplica as migrações versionadas; o seed é idempotente.
CMD ["sh", "-c", "npx prisma migrate deploy && npx prisma db seed && npm run start:dev"]
