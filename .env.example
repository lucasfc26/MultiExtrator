# Copie para .env e preencha. O .env não vai para o git.

# ── n8n ──────────────────────────────────────────────────────────────────────
# URL pública do n8n (com barra no fim). É a base de /webhook/... e da
# url_codigo que a 2 VIA devolve — tem que ser acessível por quem chama a API.
N8N_URL=http://localhost:5678/
N8N_PORT=5678
# Chave que criptografa as credenciais salvas no n8n. Gere uma vez e não troque:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# true quando o n8n estiver atrás de HTTPS
N8N_SECURE_COOKIE=false

# ── Chaves dos captchas (ficam só no worker) ─────────────────────────────────
# Site ENEL (reCAPTCHA)
CAPSOLVER_API_KEY=
# 2 VIA ENEL (hCaptcha)
NONECAP_API_KEY=

# Proxy residencial da 2 VIA (opcional): [http://|socks5://][usuario:senha@]host:porta
# A ENEL/hCaptcha barram IP de datacenter; numa VPS costuma ser necessário.
SEGUNDA_VIA_PROXY=

# ── Worker ───────────────────────────────────────────────────────────────────
# Navegador do Site ENEL e do Corporativo: camoufox (validado em produção no
# multiextrator) ou chrome. A 2 VIA usa sempre o Chrome.
NAVEGADOR_SITE_ENEL=camoufox
NAVEGADOR_CORPORATIVO=camoufox
# Extrações ao mesmo tempo (cada uma é um navegador). Numa VPS de 2 vCPU, 1.
# Atenção: uma 2 VIA esperando o código ocupa a vaga por até OTP_TIMEOUT_S.
MAX_JOBS_SIMULTANEOS=1
# Limite de cada extração em segundos (sem contar a espera do código)
JOB_TIMEOUT_S=1200
# Espera máxima pelo código OTP da 2 VIA, em segundos
OTP_TIMEOUT_S=600
