# API Fatturas — copie para .env (rodando fora do Docker).
# No Docker de desenvolvimento estas variáveis vêm do docker-compose.dev.yml.

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
# Frontend: base dos links enviados por e-mail e origem liberada no CORS.
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql://fatturas:fatturas@localhost:5432/fatturas?schema=public

# Segredos: gere com `openssl rand -hex 32`. Nunca use estes valores fora do dev.
JWT_ACCESS_SECRET=dev-access-secret-troque-por-um-valor-aleatorio-longo
DOWNLOAD_URL_SECRET=dev-download-secret-troque-por-um-valor-aleatorio-longo
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret-troque
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
# true quando estiver atrás de HTTPS
COOKIE_SECURE=false

# E-mail (dev: Mailpit — caixa de entrada em http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Fatturas <nao-responda@fatturas.local>
MAIL_SALES_TO=comercial@fatturas.local

# Motor de busca de faturas (worker Python deste repositório)
WORKER_URL=http://localhost:8000
WORKER_POLL_MS=3000

# Arquivos
STORAGE_DIR=./storage
RETENTION_DAYS=30
EXPIRY_WARNING_DAYS=5
DOWNLOAD_URL_TTL_S=300
UPLOAD_MAX_BYTES=10485760

# Créditos e cobrança (ver docs/cobranca.md)
SIGNUP_BONUS_CREDITS=200
COST_SITE_ENEL=3
COST_CORPORATIVO=2
COST_SEGUNDA_VIA=5
EXTRACTION_COST_MIN=5
EXTRACTION_COST_MAX=8
LOW_CREDITS_THRESHOLD=20

# Pagamentos: "fake" = gateway de desenvolvimento (nada é cobrado)
PAYMENT_PROVIDER=fake
PAYMENT_EXPIRES_MIN=30
