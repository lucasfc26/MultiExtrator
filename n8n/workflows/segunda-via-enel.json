      "credentials": {
        "httpHeaderAuth": {
          "id": "multiextractor-api-key",
          "name": "MultiExtractor API Key"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://worker:8000/extracoes/segunda-via",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 1800000
        },
        "sendBody": true,
